DATABASE_URL=postgresql://postgres:root@localhost:5432/migr8
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
APP_ENV=development

# auto = local disk when no AWS creds; s3 = always S3 (required in production)
STORAGE_BACKEND=auto
PUBLIC_API_BASE_URL=http://localhost:8000

# Optional on EC2 — leave unset to use IAM instance role
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET=migr8-ai-validation
S3_PRESIGN_TTL_SECONDS=300

# Bedrock LLM — Sonnet for mapping; Haiku for regex + chat
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
BEDROCK_HAIKU_MODEL_ID=us.anthropic.claude-haiku-4-5
BEDROCK_EMBED_MODEL_ID=cohere.embed-v4:0
EMBEDDING_BACKEND=auto
BEDROCK_REGION=us-east-1
# BEDROCK_ACCESS_KEY=

# First admin (promoted on login/register). Leave unset to promote via SQL.
# ADMIN_EMAIL=you@company.com

# Cookie flags: local HTTP uses lax + insecure. Production cross-site (Amplify → ECS) needs:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional read-only S/4 MCP adapter. Empty = local DDIC catalog fallback.
# SAP_MCP_URL=
# SAP_MCP_TOKEN=

# Comma-separated CORS origins (Amplify URL in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JSON_LOGS=true
