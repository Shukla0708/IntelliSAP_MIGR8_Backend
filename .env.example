DATABASE_URL=postgresql://postgres:root@localhost:5432/migr8
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# auto = local disk when no AWS creds; s3 = always S3 (use on EC2 with IAM role)
STORAGE_BACKEND=auto
PUBLIC_API_BASE_URL=http://localhost:8000

# Optional on EC2 — leave unset to use IAM instance role
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET=migr8-ai-validation

# Bedrock LLM — inference profile id (approved: Claude Sonnet 5)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
# us.* models must use us-east-1 endpoint (can differ from AWS_REGION for S3/RDS)
BEDROCK_REGION=us-east-1

# Optional — Bedrock API key from console (ABSK...). Used for LLM calls instead of IAM.
# BEDROCK_ACCESS_KEY=

# Comma-separated CORS origins (add EC2 frontend URL on deploy)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
